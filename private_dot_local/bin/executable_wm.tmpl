#!/bin/bash

set -x

source ~/.config/wm/monitor.sh

case "$1" in
{{- if eq .chezmoi.hostname "gongt-glaptop2" }}
    "k")
        case "$2" in
            "d")
                setxkbmap -device $(xinput list --id-only 'AT Translated Set 2 keyboard') -option ctrl:swapcaps -option altwin:swap_lalt_lwin -layout us -variant dvorak
                ;;
            "q")
                setxkbmap -device $(xinput list --id-only 'AT Translated Set 2 keyboard') -layout us -variant "" -option
                ;;
        esac
        ;;
    "a")
        case "$2" in
            "w")
                xrandr --output DP-2-1 --auto --primary --output DP-2-8 --right-of DP-2-1 --auto --output eDP-1 --mode 2560x1600 --below DP-2-8
                # Note that the positioning must be a separate command otherwise it doesn't work half thtime.
                xrandr --setmonitor *big auto DP-2-1,DP-2-8
                xrandr --output eDP-1 --pos 1280x1440
                echo "MONITOR=w" > ~/.config/wm/monitor.sh
                ;;
            "b")
                xrandr --output DP-2 --mode 3840x1600 --primary --output eDP-1 --mode 2560x1600 --below DP-2
                xrandr --output eDP-1 --pos 640x1600
                echo "MONITOR=b" > ~/.config/wm/monitor.sh
                ;;
            "")
                xrandr --output DP-2 --mode 5120x1440 --primary --output eDP-1 --mode 2560x1600 --below DP-2
                xrandr --output eDP-1 --pos 1280x1440
                echo "MONITOR=h" > ~/.config/wm/monitor.sh
                ;;
        esac
        sleep 1
        xrdb -merge <.Xresources
        ;;
    "b")
        case "$2" in
        "")
            xsetroot -solid black
        ;;
        *)
            TARGET_IMG=$(realpath "$2")
            TARGET_DISPLAY="eDP-1"
            FALLBACK_COLOR="000000"

            # Create a temporary 1x1 transparent pixel to act as our "blank" image
            TRANSPARENT_PIXEL="/tmp/transparent_pixel.png"
            if [ ! -f "$TRANSPARENT_PIXEL" ]; then
                convert -size 1x1 xc:none "$TRANSPARENT_PIXEL"
            fi

            # 1. Paint the entire X11 root window with your fallback solid color first
            xsetroot -solid "$FALLBACK_COLOR"

            # 2. Get the exact ordered list of connected monitors from xrandr
            readarray -t MONITORS < <(xrandr --listmonitors | awk 'NR>1 {print $4}')

            # 3. Verify eDP-1 is actually in the list
            if [[ ! " ${MONITORS[@]} " =~ " ${TARGET_DISPLAY} " ]]; then
                echo "Error: Display $TARGET_DISPLAY not found in active xrandr layout."
                exit 1
            fi

            # 4. Construct the precise argument list for feh
            FEH_ARGS=()
            for MON in "${MONITORS[@]}"; do
                if [ "$MON" == "$TARGET_DISPLAY" ]; then
                    FEH_ARGS+=("$TARGET_IMG")
                else
                    # Pass the transparent pixel; the xsetroot color will show underneath it
                    FEH_ARGS+=("$TRANSPARENT_PIXEL")
                fi
            done

            # 5. Execute feh
            feh --bg-max "${FEH_ARGS[@]}"
        ;;
        esac
        ;;
    "d")
        case "$2" in
            "w")
                xrandr --output DP-2-8 --off --output DP-2-1 --off --output eDP-1 --mode 2560x1600 --primary
                xrandr --delmonitor big
                ;;
            "")
                xrandr --output DP-1 --off --output DP-2 --off --output DP-3 --off --output DP-4 --off --output HDMI-1 --off --output eDP-1 --auto --mode 2560x1600 --primary
                xrandr --output DP-2-8 --off --output DP-2-1 --off --output eDP-1 --mode 2560x1600 --primary
                xrandr --delmonitor big
                echo "MONITOR=d" > ~/.config/wm/monitor.sh
                ;;
        esac
        sleep 1
        xrdb -merge <.Xresources
        ;;
{{- end }}
{{- if eq .chezmoi.hostname "gongt-glaptop2" }}
    "o")
        i3-msg 'exec google-chrome --new-window calendar.google.com;
        exec google-chrome --new-window https://mail.google.com/chat/u/0/#chat/home;
        exec obsidian'
        ;;
    "m")
        i3-msg '[title="pulsemixer"] mark a
        [title="Calendar"] mark c
        [title="Easy Effects"] mark e
        [title="Chat"] mark h
        [title="obsidian"] mark o
        [title="terminal"] mark s
        [con_mark="."] move scratchpad'
        ;;
{{- else }}
    "mo")
        xinput | rg -o -r '$1' 'Apple.*id=([0-9]+)' | xargs -I {} xinput set-prop {} "Coordinate Transformation Matrix" 3, 0, 0, 0, 3, 0, 0, 0, 1
        ;;
    "o")
        i3-msg 'exec chromium --new-window 1password.com;
        exec chromium --new-window calendar.google.com;
        exec chromium --new-window gmail.com;
        exec chromium --new-window todoist.com;
        exec chromium --new-window music.youtube.com;
        exec chromium --new-window;
        exec obsidian'
        ;;
    "m")
        i3-msg '[title="pulsemixer"] mark a
        [title="New Tab"] mark b
        [title="Calendar"] mark c
        [title="Easy Effects"] mark e
        [title="Gmail"] mark m
        [title="obsidian"] mark o
        [title="terminal"] mark s
        [title="Todoist"] mark t
        [title="Music"] mark y
        [title="1Password"] mark 1
        [con_mark="."] move scratchpad'
        ;;
{{- end }}
    "s")
        case "$2" in
        "s")
            import png:- | xclip -selection clipboard -t image/png
        ;;
        "")
            import -window $(xdotool getactivewindow) png:- | xclip -selection clipboard -t image/png
        ;;
        esac
    ;;
    "c")
        case "$2" in
        "l")
            gsettings set org.gnome.desktop.interface color-scheme 'default'
            ln -sf ~/.config/alacritty/themes/themes/gruvbox_light.toml ~/.config/alacritty/themes/theme.toml
            touch ~/.config/alacritty/alacritty.toml
        ;;
        "d")
            gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
            ln -sf ~/.config/alacritty/themes/themes/gruvbox_dark.toml ~/.config/alacritty/themes/theme.toml
            touch ~/.config/alacritty/alacritty.toml
        ;;
        esac
    ;;
    "i")
        case "${MONITOR:=d}" in
            "d")
                ARGS=("--terminal" "50" "--browser" "50")
                ;;
            "b")
                ARGS=("--terminal" "22" "--browser" "33")
                ;;
            "w" | "h")
                ARGS=("--terminal" "17" "--browser" "25")
                ;;
        esac
        case "$2" in
        "c")
            i3ext "${ARGS[@]}" center
            ;;
        "r")
            i3ext "${ARGS[@]}" center right
            ;;
        "l")
            i3ext "${ARGS[@]}" center left
            ;;
        "z")
            i3ext "${ARGS[@]}" resize-all
            ;;
        esac
        ;;
esac
