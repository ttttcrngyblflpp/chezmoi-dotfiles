# This file has been auto-generated by i3-config-wizard(1).
# It will not be overwritten, so edit it as you like.
#
# Should you change your keyboard layout some time, delete
# this file and re-run i3-config-wizard(1).
#

{{- if eq .chezmoi.hostname "gongt-glaptop2" }}
exec aw-qt

bindsym Mod4+Home exec wm k d
bindsym Mod4+End exec wm k q
{{- end }}

# bindings for attaching to/detaching from an external monitor
{{- if eq .chezmoi.hostname "gongt-glaptop2" }}
# Define the mode name
set $mode_attach Attach to Monitor (h) home, (b) bedroom, (w) work

mode "$mode_attach" {
    bindsym h exec wm a; mode "default"
    bindsym w exec wm a w; mode "default"
    bindsym b exec wm a b; mode "default"

    # Back to normal: Enter or Escape
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

{{- else }}
# Define the mode name
set $mode_attach Attach to Monitor (h) home, (k) Kovaaks, (s) Slay the Spire 2

mode "$mode_attach" {
    bindsym h exec wm a; mode "default"
    bindsym k exec wm a k; mode "default"
    bindsym s exec wm a s; mode "default"

    # Back to normal: Enter or Escape
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

{{- end }}
bindsym Mod4+Control+a mode "$mode_attach"
bindsym Mod4+Control+i exec wm d

# start a browser
{{- if .is_work }}
bindsym Mod4+Tab exec alacritty -e google-chrome
{{- else }}
bindsym Mod4+Tab exec chromium
{{- end }}

bindsym Mod4+t exec wm c l
bindsym Mod4+Control+t exec wm c d

bindsym Mod4+Control+o exec alacritty -e pulsemixer, exec easyeffects, exec alacritty --title terminal, exec wm o
bindsym Mod4+o exec wm m

bindsym Mod4+Control+s exec systemctl suspend

bindsym Mod4+Control+m exec i3-input -F 'mark %s' -l 1 -P 'Mark: '
bindsym Mod4+m exec i3-input -F '[con_mark="%s"] focus' -l 1 -P 'Goto: '
exec wm mo

bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +2% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -2% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set 5%+

bindsym Mod4+semicolon exec i3-input -F "exec i3-msg %s" -P 'i3-msg '

bindsym Mod4+b focus output down
bindsym Mod4+Control+b move workspace to output down

# resize window
bindsym Mod4+Right exec i3ext resize --direction right --percentage 1
bindsym Mod4+Control+Right exec i3-input -F 'exec i3ext resize --direction right --percentage %s' -P 'resize right: '
bindsym Mod4+Up exec i3ext resize --direction right --percentage "-1"
bindsym Mod4+Left exec i3ext resize --direction left --percentage 1
bindsym Mod4+Control+Left exec i3-input -F 'exec i3ext resize --direction left --percentage %s' -P 'resize left: '
bindsym Mod4+Down exec i3ext resize --direction left --percentage "-1"

# resize toplevel containers
bindsym Mod4+c exec wm i c
bindsym Mod4+r exec wm i r
bindsym Mod4+g exec wm i l
bindsym Mod4+z exec wm i z
bindsym Mod4+Control+z exec i3-input -F "exec i3-msg [floating] resize set %s" -P 'i3-msg [floating] resize set '

# Rename current window
bindsym Mod4+n exec i3-input -F "title_format %s"

# Rename current workspace
bindsym Mod4+Control+n exec NUM=$(i3-msg -t get_workspaces | jq -r '.[] | select(.focused==true).name' | cut -d':' -f1) && i3-input -F "rename workspace to $NUM:%s"

# Take screenshot and copy to clipboard
bindsym --release Mod4+Delete exec --no-startup-id wm s
bindsym --release Mod4+Control+Delete exec --no-startup-id wm s s

# start a terminal
bindsym Mod4+grave exec alacritty
#bindsym Mod4+Control+grave [workspace="__focused__"] split vertical; [workspace="__focused__"] layout stacking

# start a placeholder
bindsym Mod4+Prior open

# change focus
bindsym Mod4+comma focus left
bindsym Mod4+j focus down
bindsym Mod4+k focus up
bindsym Mod4+period focus right

# move focused window
bindsym Mod4+Control+comma move left
bindsym Mod4+Control+j move down
bindsym Mod4+Control+k move up
bindsym Mod4+Control+period move right

bindsym Mod4+d scratchpad show
bindsym Mod4+Control+d move scratchpad

# Disable window titlebars always
default_border pixel 1

# Set a gaps of 10 (outer gaps is unset because it's added to this)
gaps inner 10
gaps outer -10

# class                 border  backgr. text    indicator child_border
client.focused          #f58b54 #f58b54 #ffffff #ffffff   #f58b54

# i3 config file (v4)
#
# Please see https://i3wm.org/docs/userguide.html for a complete reference!

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:monospace 10

# This font is widely installed, provides lots of unicode glyphs, right-to-left
# text rendering and scalability on retina/hidpi displays (thanks to pango).
#font pango:DejaVu Sans Mono 8

# Before i3 v4.8, we used to recommend this one as the default:
# font -misc-fixed-medium-r-normal--13-120-75-75-C-70-iso10646-1
# The font above is very space-efficient, that is, it looks good, sharp and
# clear in small sizes. However, its unicode glyph coverage is limited, the old
# X core fonts rendering does not support right-to-left and this being a bitmap
# font, it doesn’t scale on retina/hidpi displays.

# Use Mouse+Mod4 to drag floating windows to their wanted position
floating_modifier Mod4

bindsym Mod4+equal focus mode_toggle
bindsym Mod4+Control+equal floating toggle

# kill focused window
bindsym Mod4+Control+w kill

# start dmenu (a program launcher)
bindsym Mod4+minus exec dmenu_run
# There also is the (new) i3-dmenu-desktop which only displays applications
# shipping a .desktop file. It is a wrapper around dmenu, so you need that
# installed.
# bindsym Mod4+d exec --no-startup-id i3-dmenu-desktop

# enter fullscreen mode for the focused container
bindsym Mod4+f fullscreen toggle

# Define the mode name
set $mode_layout Layout (h) horizontal, (v) vertical, (s) stacking, (t) tabbed

mode "$mode_layout" {
    # change container layout (stacked, tabbed, toggle split)
    bindsym s layout stacking; mode "default"
    bindsym Shift+s split vertical; layout stacking; mode "default"
    bindsym t layout tabbed; mode "default"
    bindsym Shift+t split horizontal; layout tabbed; mode "default"

    bindsym h layout splith; mode "default"
    bindsym Shift+h split horizontal; mode "default"
    bindsym v layout splitv; mode "default"
    bindsym Shift+v split vertical; mode "default"


    # Back to normal: Enter or Escape
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# Bind a "hard to hit" key to enter the mode
bindsym Mod4+Control+l mode "$mode_layout"

# focus the parent container
bindsym Mod4+a focus parent

# focus the child container
bindsym Mod4+i focus child

# switch to workspace
bindsym Mod4+1 workspace number 1
bindsym Mod4+2 workspace number 2
bindsym Mod4+3 workspace number 3
bindsym Mod4+4 workspace number 4
bindsym Mod4+5 workspace number 5
bindsym Mod4+6 workspace number 6
bindsym Mod4+7 workspace number 7
bindsym Mod4+8 workspace number 8
bindsym Mod4+9 workspace number 9
bindsym Mod4+0 workspace number 0

# move focused container to workspace
bindsym Mod4+Control+1 move container to workspace number 1
bindsym Mod4+Control+2 move container to workspace number 2
bindsym Mod4+Control+3 move container to workspace number 3
bindsym Mod4+Control+4 move container to workspace number 4
bindsym Mod4+Control+5 move container to workspace number 5
bindsym Mod4+Control+6 move container to workspace number 6
bindsym Mod4+Control+7 move container to workspace number 7
bindsym Mod4+Control+8 move container to workspace number 8
bindsym Mod4+Control+9 move container to workspace number 9
bindsym Mod4+Control+0 move container to workspace number 0

# reload the configuration file
bindsym Mod4+Control+c reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym Mod4+Control+r restart
# exit i3 (logs you out of your X session)

# Start i3bar to display a workspace bar (plus the system information i3status
# finds out, if available)
bar {
   mode hide
   modifier Mod4
	position top
        status_command i3status-rs
	tray_output primary
}
